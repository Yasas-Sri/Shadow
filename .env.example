# Copy to .env and fill in. NEVER commit .env.
POSTGRES_USER=shadow
POSTGRES_PASSWORD=shadow
POSTGRES_DB=production
POSTGRES_PORT=5432

# Read-only Postgres MCP server (agent's connection to the demo DB).
SHADOW_DATABASE_URL=postgres://shadow:shadow@localhost:5432/production
MCP_PORT=8000

# Write-capable Postgres MCP server (apply_migration, approval-gated).
MCP_WRITE_PORT=8001
# Shared secret: the write server requires it, register-write.sh sends it to the harness so
# only the harness can reach the write tool. Generate one: `openssl rand -hex 24`.
MCP_WRITE_TOKEN=

# TrueForge harness (where register.sh PUTs the MCP server).
TRUEFORGE_URL=http://localhost:8790

# Daytona sandbox (free at https://daytona.io) — required for the shadow dry-run
# and for skills to load. Registered via trueforge/register-sandbox.sh.
# DAYTONA_API_KEY=

# Bring-your-own model key for the TrueForge model catalog.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
