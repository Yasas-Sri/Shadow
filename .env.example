# Copy to .env and fill in. NEVER commit .env.
POSTGRES_USER=shadow
POSTGRES_PASSWORD=shadow
POSTGRES_DB=production
POSTGRES_PORT=5432

# Read-only Postgres MCP server (agent's connection to the demo DB).
SHADOW_DATABASE_URL=postgres://shadow:shadow@localhost:5432/production
MCP_PORT=8000

# TrueForge harness (where register.sh PUTs the MCP server).
TRUEFORGE_URL=http://localhost:8790

# Bring-your-own model key for the TrueForge model catalog.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
